# cp .env.example .env 후 값 입력 (.env는 git에 올리지 않음)
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_BASE_URL=http://localhost/v1
METRIC_TOOL_URL=http://localhost:8000

# Deep Review (Paperclip). Paperclip은 dev.sh가 127.0.0.1:3110으로 띄운다
DEEP_REVIEW_ENABLED=false
PAPERCLIP_API_URL=http://127.0.0.1:3110/api
PAPERCLIP_UI_URL=http://127.0.0.1:3110
